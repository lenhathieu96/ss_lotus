# Public browser configuration. Do not add service-role keys to this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public HTTPS base for the S3 documents/ prefix. Never put AWS credentials here.
NEXT_PUBLIC_S3_LIBRARY_BASE_URL=

# Backend credentials belong to the Supabase Function secret store, not Next/Vercel.
# See docs/library-function-contract.md for local and deployed Function setup.
