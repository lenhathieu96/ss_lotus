# Public browser configuration. Do not add service-role keys to this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public HTTPS base for the S3 documents/ prefix. Never put AWS credentials here.
NEXT_PUBLIC_S3_LIBRARY_BASE_URL=

# Server-only deployment variables (configure in the host's secure environment):
# AWS_REGION=ap-southeast-1
# S3_LIBRARY_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS= # SS Lotus Vercel alias; AWS_SECRET_ACCESS_KEY is also accepted.
# SUPABASE_SERVICE_ROLE_KEY=
